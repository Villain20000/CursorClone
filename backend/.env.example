# ─── Required ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cursorclone?schema=public"
JWT_ACCESS_SECRET="your-32-char-or-longer-access-secret-key-here-change-in-production"
JWT_REFRESH_SECRET="your-32-char-or-longer-refresh-secret-key-here-change-in-production"

# ─── Optional ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# ─── OAuth (optional) ───────────────────────────────────────────────
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ─── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
